NEXT_PUBLIC_P3_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.ap-northeast-2.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-app-client-id
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_COGNITO_KAKAO_PROVIDER=Kakao
NEXT_PUBLIC_COGNITO_GOOGLE_PROVIDER=Google
# 판매자 홈 화면 구현 후 실제 route로 설정한다.
NEXT_PUBLIC_SELLER_HOME_PATH=
# Portfolio demo mode is enabled by default. Set false only when a live backend is available.
NEXT_PUBLIC_DEMO_MODE=true
